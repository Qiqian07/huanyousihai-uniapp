<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.hys.mapper.HysAlbumMapper">

    <resultMap type="HysAlbum" id="HysAlbumResult">
        <id     property="albumId"    column="album_id"/>
        <result property="batchTitle" column="batch_title"/>
        <result property="tripDate"   column="trip_date"/>
        <result property="cover"      column="cover"/>
        <result property="images"     column="images"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <sql id="selectColumns">
        select album_id, batch_title, trip_date, cover, images, create_time
        from hys_album
    </sql>

    <select id="selectById" parameterType="Long" resultMap="HysAlbumResult">
        <include refid="selectColumns"/>
        where album_id = #{albumId}
    </select>

    <select id="selectList" parameterType="HysAlbum" resultMap="HysAlbumResult">
        <include refid="selectColumns"/>
        <where>
            <if test="batchTitle != null and batchTitle != ''">and batch_title like concat('%', #{batchTitle}, '%')</if>
        </where>
        order by trip_date desc
    </select>

    <insert id="insertAlbum" parameterType="HysAlbum" useGeneratedKeys="true" keyProperty="albumId">
        insert into hys_album (batch_title, trip_date, cover, images, create_time)
        values (#{batchTitle}, #{tripDate}, #{cover}, #{images}, #{createTime})
    </insert>

    <update id="updateAlbum" parameterType="HysAlbum">
        update hys_album
        <set>
            <if test="batchTitle != null and batchTitle != ''">batch_title = #{batchTitle},</if>
            <if test="tripDate != null and tripDate != ''">trip_date = #{tripDate},</if>
            <if test="cover != null">cover = #{cover},</if>
            <if test="images != null">images = #{images},</if>
        </set>
        where album_id = #{albumId}
    </update>

    <delete id="deleteAlbumByIds" parameterType="Long">
        delete from hys_album where album_id in
        <foreach collection="array" item="albumId" open="(" separator="," close=")">
            #{albumId}
        </foreach>
    </delete>
</mapper>
