<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.hys.mapper.HysRouteMapper">

    <resultMap type="HysRoute" id="HysRouteResult">
        <id     property="routeId"          column="route_id"/>
        <result property="title"            column="title"/>
        <result property="cover"            column="cover"/>
        <result property="videoUrl"         column="video_url"/>
        <result property="days"             column="days"/>
        <result property="normalPriceCents" column="normal_price_cents"/>
        <result property="vipPriceCents"    column="vip_price_cents"/>
        <result property="gatherTime"       column="gather_time"/>
        <result property="gatherPlace"      column="gather_place"/>
        <result property="itinerary"        column="itinerary"/>
        <result property="status"           column="status"/>
        <result property="sort"             column="sort"/>
        <result property="createTime"       column="create_time"/>
    </resultMap>

    <sql id="selectColumns">
        select route_id, title, cover, video_url, days, normal_price_cents, vip_price_cents,
               gather_time, gather_place, itinerary, status, sort, create_time
        from hys_route
    </sql>

    <select id="selectById" parameterType="Long" resultMap="HysRouteResult">
        <include refid="selectColumns"/>
        where route_id = #{routeId}
    </select>

    <select id="selectOnline" resultMap="HysRouteResult">
        <include refid="selectColumns"/>
        where status = '0' order by sort asc, route_id desc
    </select>

    <select id="selectList" parameterType="HysRoute" resultMap="HysRouteResult">
        <include refid="selectColumns"/>
        <where>
            <if test="title != null and title != ''">and title like concat('%', #{title}, '%')</if>
            <if test="status != null and status != ''">and status = #{status}</if>
        </where>
        order by sort asc, route_id desc
    </select>

    <insert id="insertRoute" parameterType="HysRoute" useGeneratedKeys="true" keyProperty="routeId">
        insert into hys_route (title, cover, video_url, days, normal_price_cents, vip_price_cents,
                               gather_time, gather_place, itinerary, status, sort, create_time)
        values (#{title}, #{cover}, #{videoUrl}, #{days}, #{normalPriceCents}, #{vipPriceCents},
                #{gatherTime}, #{gatherPlace}, #{itinerary}, #{status}, #{sort}, #{createTime})
    </insert>

    <update id="updateRoute" parameterType="HysRoute">
        update hys_route
        <set>
            <if test="title != null and title != ''">title = #{title},</if>
            <if test="cover != null">cover = #{cover},</if>
            <if test="videoUrl != null">video_url = #{videoUrl},</if>
            <if test="days != null">days = #{days},</if>
            <if test="normalPriceCents != null">normal_price_cents = #{normalPriceCents},</if>
            <if test="vipPriceCents != null">vip_price_cents = #{vipPriceCents},</if>
            <if test="gatherTime != null">gather_time = #{gatherTime},</if>
            <if test="gatherPlace != null">gather_place = #{gatherPlace},</if>
            <if test="itinerary != null">itinerary = #{itinerary},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="sort != null">sort = #{sort},</if>
        </set>
        where route_id = #{routeId}
    </update>

    <delete id="deleteRouteByIds" parameterType="Long">
        delete from hys_route where route_id in
        <foreach collection="array" item="routeId" open="(" separator="," close=")">
            #{routeId}
        </foreach>
    </delete>
</mapper>
