<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.hys.mapper.HysProductMapper">

    <resultMap type="HysProduct" id="HysProductResult">
        <id     property="productId"        column="product_id"/>
        <result property="title"            column="title"/>
        <result property="cover"            column="cover"/>
        <result property="spec"             column="spec"/>
        <result property="normalPriceCents" column="normal_price_cents"/>
        <result property="vipPriceCents"    column="vip_price_cents"/>
        <result property="stock"            column="stock"/>
        <result property="status"           column="status"/>
        <result property="sort"             column="sort"/>
        <result property="createTime"       column="create_time"/>
    </resultMap>

    <sql id="selectColumns">
        select product_id, title, cover, spec, normal_price_cents, vip_price_cents,
               stock, status, sort, create_time
        from hys_product
    </sql>

    <select id="selectById" parameterType="Long" resultMap="HysProductResult">
        <include refid="selectColumns"/>
        where product_id = #{productId}
    </select>

    <select id="selectOnline" resultMap="HysProductResult">
        <include refid="selectColumns"/>
        where status = '0' order by sort asc, product_id desc
    </select>

    <select id="selectList" parameterType="HysProduct" resultMap="HysProductResult">
        <include refid="selectColumns"/>
        <where>
            <if test="title != null and title != ''">and title like concat('%', #{title}, '%')</if>
            <if test="status != null and status != ''">and status = #{status}</if>
        </where>
        order by sort asc, product_id desc
    </select>

    <insert id="insertProduct" parameterType="HysProduct" useGeneratedKeys="true" keyProperty="productId">
        insert into hys_product (title, cover, spec, normal_price_cents, vip_price_cents,
                                 stock, status, sort, create_time)
        values (#{title}, #{cover}, #{spec}, #{normalPriceCents}, #{vipPriceCents},
                #{stock}, #{status}, #{sort}, #{createTime})
    </insert>

    <update id="updateProduct" parameterType="HysProduct">
        update hys_product
        <set>
            <if test="title != null and title != ''">title = #{title},</if>
            <if test="cover != null">cover = #{cover},</if>
            <if test="spec != null">spec = #{spec},</if>
            <if test="normalPriceCents != null">normal_price_cents = #{normalPriceCents},</if>
            <if test="vipPriceCents != null">vip_price_cents = #{vipPriceCents},</if>
            <if test="stock != null">stock = #{stock},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="sort != null">sort = #{sort},</if>
        </set>
        where product_id = #{productId}
    </update>

    <delete id="deleteProductByIds" parameterType="Long">
        delete from hys_product where product_id in
        <foreach collection="array" item="productId" open="(" separator="," close=")">
            #{productId}
        </foreach>
    </delete>

    <!-- 原子扣库存：库存不足返回 0 行 -->
    <update id="deductStock">
        update hys_product set stock = stock - #{count}
        where product_id = #{productId} and stock &gt;= #{count}
    </update>
</mapper>
